# ============================================================
# 環境変数テンプレート（.env にコピーして実際の値を設定）
# ============================================================

# Gemini の中継（proxy/gemini）の URL。API キーはアプリに入れない（キーは中継の秘密の設定に入れる）
EXPO_PUBLIC_GEMINI_PROXY_URL=https://budrec-gemini-proxy.your-subdomain.workers.dev

# Google OAuth クライアントID（Google Cloud Console → 認証情報）
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=your_android_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=your_web_client_id.apps.googleusercontent.com

# Google Sheets スプレッドシートID（URLの /d/{ID}/ 部分）
EXPO_PUBLIC_SPREADSHEET_ID=your_spreadsheet_id_here
