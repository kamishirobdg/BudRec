"use client";
// Middle tiles whose visual centering must be stable across SEED (rot) changes.
const MIDDLE_STABLE_BBOX_SLOTS = new Set(["M1", "M2", "M3", "M4"] as const);

const MIDDLE_SLOTS_PER_ROT = new Set(["M1", "M2", "M3", "M4", "M5", "M6", "M7", "M8"] as const);

function fmtNum(n: number, dp: number = 6): number {
  if (!Number.isFinite(n)) return 0;
  const m = Math.pow(10, dp);
  return Math.round(n * m) / m;
}

function rotateOffset(dx: number, dy: number, deg: number) {
  if (!dx && !dy) return { dx: 0, dy: 0 };
  const rad = (deg * Math.PI) / 180;
  const cos = Math.cos(rad);
  const sin = Math.sin(rad);
  return { dx: dx * cos - dy * sin, dy: dx * sin + dy * cos };
}

function rotatePoint(x: number, y: number, deg: number) {
  if (!x && !y) return { x: 0, y: 0 };
  const rad = (deg * Math.PI) / 180;
  const cos = Math.cos(rad);
  const sin = Math.sin(rad);
  return { x: x * cos - y * sin, y: x * sin + y * cos };
}

import * as React from "react";
import type { TemplateDef } from "@/gaia/data/templates/types";

type Axial = { q: number; r: number };

// rot30（30度単位の追加回転）
export type PlacementItem = { slotId: string; sectorId: string; rot: number; rot30?: number };

function parseKey(key: string): Axial {
  const [q, r] = key.split(",").map((v) => Number(v));
  return { q, r };
}

function axialRotateCCW(pos: Axial, rot60: number): Axial {
  let x = pos.q;
  let z = pos.r;
  let y = -x - z;

  const r = ((rot60 % 6) + 6) % 6;
  for (let i = 0; i < r; i++) {
    // (x,y,z) -> (-z, -x, -y)
    const nx = -z;
    const ny = -x;
    const nz = -y;
    x = nx;
    y = ny;
    z = nz;
  }
  return { q: x, r: z };
}

function axialToPixelPointy(pos: Axial, size: number) {
  const x = size * Math.sqrt(3) * (pos.q + pos.r / 2);
  const y = size * (3 / 2) * pos.r;
  return { x, y };
}

function computeBounds(points: Array<{ x: number; y: number }>, pad: number) {
  if (points.length === 0) return { minX: 0, minY: 0, maxX: 0, maxY: 0 };
//if (points.length === 0) return { minX: -100, minY: -100, maxX: 100, maxY: 100 };
  let minX = Infinity,
    minY = Infinity,
    maxX = -Infinity,
    maxY = -Infinity;
  for (const p of points) {
    minX = Math.min(minX, p.x);
    minY = Math.min(minY, p.y);
    maxX = Math.max(maxX, p.x);
    maxY = Math.max(maxY, p.y);
  }
  return { minX: minX - pad, minY: minY - pad, maxX: maxX + pad, maxY: maxY + pad };
}

/**
 * Base(LARGE)の行シフト補正（確定仕様）
 * shift = floor((r + R)/2), q' = q - shift
 */
function fixBaseLocalCoord(sector: any, local: Axial): Axial {
  const R = typeof sector?.radius === "number" ? sector.radius : null;
  if (R === null) return local;
  const shift = Math.floor((local.r + R) / 2);
  return { q: local.q - shift, r: local.r };
}

type InflateByAccepts = Partial<Record<"LARGE" | "MIDDLE" | "SMALL", number>>;
type RotateOffsetByAccepts = Partial<Record<"LARGE" | "MIDDLE" | "SMALL", number>>;
type ScaleByAccepts = Partial<Record<"LARGE" | "MIDDLE" | "SMALL", number>>;
type ImgOffsetByAccepts = Partial<Record<"LARGE" | "MIDDLE" | "SMALL", { dx: number; dy: number }>>;

// ★修正：slotId別の手動offsetは Map ではなく Record で受ける（UI編集しやすい・デフォルトも安全）
type ImgOffsetBySlotId = Record<string, { dx: number; dy: number }>;

type RotOffsetsBySlotId = Record<string, Partial<Record<0 | 1 | 2 | 3 | 4 | 5, { dx: number; dy: number }>>>;

function normalizeAccepts0(raw: any): "LARGE" | "MIDDLE" | "SMALL" {
  const a = String(raw ?? "").toUpperCase();
  if (a === "LARGE") return "LARGE";
  if (a === "MIDDLE") return "MIDDLE";
  return "SMALL";
}

// Map/Record どちらでも参照できるようにする（page側の実装差異を吸収）
function dictGet<T>(dict: Map<string, T> | Record<string, T>, key: string): T | undefined {
  if (dict && typeof (dict as any).get === "function") {
    return (dict as Map<string, T>).get(key);
  }
  return (dict as Record<string, T>)?.[key];
}

/**
 * sector.cells のローカル座標から「外接サイズ」と「中心補正オフセット」を算出する。
 * - w/h: cellsの外接 + hex外形
 * - offsetX/Y: “形状中心” を (0,0) に寄せるための補正（rotに依存しない前提でキャッシュ）
 */
function calcTilePixelBox(sector: any, hexSize: number, inflate: number, rotationDeg: number) {
  const cells = sector?.cells ?? {};
  const keys = Object.keys(cells);

  const hexW = Math.sqrt(3) * hexSize;
  const hexH = 2 * hexSize;

  if (keys.length === 0) {
    const baseW = 6 * hexW;
    const baseH = 6 * hexH;
    return { w: baseW * inflate, h: baseH * inflate, offsetX: 0, offsetY: 0 };
  }

  const pts = keys.map((k) => {
    const local0 = parseKey(k);
    const local = fixBaseLocalCoord(sector, local0);
    const pt0 = axialToPixelPointy(local, hexSize);
    return rotatePoint(pt0.x, pt0.y, rotationDeg);
  });

  let minX = Infinity,
    minY = Infinity,
    maxX = -Infinity,
    maxY = -Infinity;
  for (const p of pts) {
    minX = Math.min(minX, p.x);
    minY = Math.min(minY, p.y);
    maxX = Math.max(maxX, p.x);
    maxY = Math.max(maxY, p.y);
  }

  const minX2 = minX - hexW / 2;
  const maxX2 = maxX + hexW / 2;
  const minY2 = minY - hexH / 2;
  const maxY2 = maxY + hexH / 2;

  const baseW = maxX2 - minX2;
  const baseH = maxY2 - minY2;

  const centerX = (minX2 + maxX2) / 2;
  const centerY = (minY2 + maxY2) / 2;

  const offsetX = -centerX;
  const offsetY = -centerY;

  return { w: baseW * inflate, h: baseH * inflate, offsetX, offsetY };
}

export function MapBoardViewer(props: {
  template: TemplateDef;
  placement: PlacementItem[];

  sectorById: Map<string, any> | Record<string, any>;
  sectorImgById: Map<string, string> | Record<string, string>;

  viewRot?: number;
  viewAngleDeg?: number;
  hexSize?: number;

  showLabels?: boolean;

  inflateByAccepts?: InflateByAccepts;
  rotateOffsetDegByAccepts?: RotateOffsetByAccepts;

  // ★タイル種別ごとの縮小率（1.0=等倍）
  scaleByAccepts?: ScaleByAccepts;

  // 種別別の手動平行移動(px)
  imgOffsetByAccepts?: ImgOffsetByAccepts;

  // ★slotId別の手動平行移動(px)（Middle個別調整など）
  imgOffsetBySlotId?: ImgOffsetBySlotId;

  // ★slotId+rot別の手動平行移動(px)（M1..M8のrot差分吸収用）
  rotOffsetsBySlotId?: RotOffsetsBySlotId;

  // 表示倍率（全体フィット維持）。zoomを上げるほど余白を減らし、大きく表示する
  zoom?: number;

  // 全体フィット用の余白(px)
  boundsPad?: number;
}) {
  const {
    template,
    placement,
    sectorById,
    sectorImgById,
    viewRot = 4,
    viewAngleDeg = -30,
    hexSize = 40,
    showLabels = true,

    inflateByAccepts = { LARGE: 1.06, MIDDLE: 1.06, SMALL: 1.06 },
    rotateOffsetDegByAccepts = { LARGE: -30, MIDDLE: 0, SMALL: 0 },

    // ★Largeは等倍、Middle/Smallのみ縮小
    scaleByAccepts = { LARGE: 1.0, MIDDLE: 0.92, SMALL: 0.88 },

    imgOffsetByAccepts = { LARGE: { dx: 0, dy: 0 }, MIDDLE: { dx: 0, dy: 0 }, SMALL: { dx: 0, dy: 0 } },

    // ★重要：ここが {} のままだと Map.get と食い違って効かない問題が出るため Record に統一
    imgOffsetBySlotId = {},
    rotOffsetsBySlotId = {},
    zoom: zoomProp,
    boundsPad: boundsPadProp,
  } = props;
  const zoom = Number.isFinite(zoomProp) && (zoomProp as number) > 0 ? (zoomProp as number) : 1;
  const boundsPad = Number.isFinite(boundsPadProp) && (boundsPadProp as number) >= 0 ? (boundsPadProp as number) : 520;
  const effectivePad = boundsPad / zoom;

  const [showDebug, setShowDebug] = React.useState(false);

  // Offset editor (UI): local editable copies (start from props)
  const [editAcceptsOffsets, setEditAcceptsOffsets] = React.useState(
    imgOffsetByAccepts ?? (OFFSET_JSON_REPLACE_ME as any).imgOffsetByAccepts ?? {}
  );
  const [editSlotOffsets, setEditSlotOffsets] = React.useState(
    imgOffsetBySlotId ?? (OFFSET_JSON_REPLACE_ME as any).imgOffsetBySlotId ?? {}
  );
  const [editSlotRotOffsets, setEditSlotRotOffsets] = React.useState(
    rotOffsetsBySlotId ?? (OFFSET_JSON_REPLACE_ME as any).rotOffsetsBySlotId ?? {}
  );

  // Effective offsets:
  // - Normal mode: use props (page.tsxで管理したSSOTを即反映)
  // - Debug/editor mode: use local editable copies (Export/Import用)
  const effectiveAcceptsOffsets = (showDebug ? editAcceptsOffsets : imgOffsetByAccepts) ?? {};
  const effectiveSlotOffsets = (showDebug ? editSlotOffsets : imgOffsetBySlotId) ?? {};
  const effectiveSlotRotOffsets = (showDebug ? editSlotRotOffsets : rotOffsetsBySlotId) ?? {};

  React.useEffect(() => {
    if (!showDebug) return;
    setEditAcceptsOffsets(imgOffsetByAccepts ?? (OFFSET_JSON_REPLACE_ME as any).imgOffsetByAccepts ?? {});
    setEditSlotOffsets(imgOffsetBySlotId ?? (OFFSET_JSON_REPLACE_ME as any).imgOffsetBySlotId ?? {});
    setEditSlotRotOffsets(rotOffsetsBySlotId ?? (OFFSET_JSON_REPLACE_ME as any).rotOffsetsBySlotId ?? {});
  }, [showDebug, imgOffsetByAccepts, imgOffsetBySlotId, rotOffsetsBySlotId]);

  const [selectedSlotId, setSelectedSlotId] = React.useState<string>("M5");
  const [selectedAccepts, setSelectedAccepts] = React.useState<"LARGE" | "MIDDLE" | "SMALL">("SMALL");

  const exportOffsetsJson = React.useMemo(() => {
    return JSON.stringify(
      { imgOffsetByAccepts: editAcceptsOffsets, imgOffsetBySlotId: editSlotOffsets, rotOffsetsBySlotId: editSlotRotOffsets },
      null,
      2
    );
  }, [editAcceptsOffsets, editSlotOffsets, editSlotRotOffsets]);

  // Import JSON (offsets)
  const [importJson, setImportJson] = React.useState<string>("");
  const [importError, setImportError] = React.useState<string | null>(null);

  const applyImportJson = React.useCallback(() => {
    const raw = (importJson || "").trim();
    if (!raw) return;
    try {
      const obj = JSON.parse(raw);
      const nextAccepts = (obj?.imgOffsetByAccepts ?? obj?.accepts ?? obj?.byAccepts) as any;
      const nextSlots = (obj?.imgOffsetBySlotId ?? obj?.slots ?? obj?.bySlotId) as any;

      if (nextAccepts && typeof nextAccepts === "object") {
        setEditAcceptsOffsets((prev: any) => ({ ...prev, ...nextAccepts }));
      }
      if (nextSlots && typeof nextSlots === "object") {
        setEditSlotOffsets((prev: any) => ({ ...prev, ...nextSlots }));
      }
      setImportError(null);
    } catch (e: any) {
      setImportError(e?.message ? String(e.message) : "Invalid JSON");
    }
  }, [importJson]);

  const slotById = React.useMemo(() => new Map(template.slots.map((s) => [s.slotId, s])), [template.slots]);

  const boxByKey = React.useMemo(() => {
    const m = new Map<string, { w: number; h: number; offsetX: number; offsetY: number }>();
    for (const p of placement) {
      const slot = slotById.get(p.slotId);
      const accepts0 = normalizeAccepts0(slot?.accepts?.[0]);
      const inflate = inflateByAccepts[accepts0] ?? 1.06;

      const offsetDeg = rotateOffsetDegByAccepts[accepts0] ?? 0;
      const extra30 = (p.rot30 ?? 0) * 30;
      const tileDeg = -(p.rot * 60) + offsetDeg + extra30;

      const bboxRotDeg = accepts0 === "MIDDLE" ? (MIDDLE_STABLE_BBOX_SLOTS.has(String(p.slotId)) ? 0 : tileDeg) : 0;
      const key = `${p.sectorId}@@${accepts0}@@${inflate}@@${bboxRotDeg}`;
      if (m.has(key)) continue;

      const sector = dictGet(sectorById, p.sectorId);
      m.set(key, calcTilePixelBox(sector, hexSize, inflate, bboxRotDeg));
    }
    return m;
  }, [placement, sectorById, slotById, hexSize, inflateByAccepts, rotateOffsetDegByAccepts]);

  const tileItems = React.useMemo(() => {
    return placement
      .map((p) => {
        const slot = slotById.get(p.slotId);
        if (!slot) return null;

        const accepts0 = normalizeAccepts0(slot.accepts?.[0]);
        const img = dictGet(sectorImgById, p.sectorId) || `/sectors/${p.sectorId}.png`;
        const inflate = inflateByAccepts[accepts0] ?? 1.06;

        // ★ 先に tileDeg を確定
        const offsetDeg = rotateOffsetDegByAccepts[accepts0] ?? 0;
        const extra30 = (p.rot30 ?? 0) * 30;
        const tileDeg = -(p.rot * 60) + offsetDeg + extra30;

        // ★ その後で key を作る
        const bboxRotDeg = accepts0 === "MIDDLE" ? (MIDDLE_STABLE_BBOX_SLOTS.has(String(p.slotId)) ? 0 : tileDeg) : 0;
        const key = `${p.sectorId}@@${accepts0}@@${inflate}@@${bboxRotDeg}`;
        const box = boxByKey.get(key) ?? { w: 240, h: 210, offsetX: 0, offsetY: 0 };

        const scale = scaleByAccepts[accepts0] ?? 1.0;
        const drawW = box.w * scale;
        const drawH = box.h * scale;
        const drawOffsetX = box.offsetX * scale;
        const drawOffsetY = box.offsetY * scale;

        const pr = axialRotateCCW(slot.pos as any, viewRot);
        const { x, y } = axialToPixelPointy(pr, hexSize);

        const manualByAccepts = (effectiveAcceptsOffsets as any)[accepts0] ?? { dx: 0, dy: 0 };
        const manualBySlot = (effectiveSlotOffsets as any)?.[p.slotId] ?? { dx: 0, dy: 0 };

        // rot別補正（M1..M8のみ）：rotに依存するズレを吸収
        const rot6 = (((Number((p as any).rot) || 0) % 6) + 6) % 6 as 0 | 1 | 2 | 3 | 4 | 5;
        const manualBySlotRot = MIDDLE_SLOTS_PER_ROT.has(p.slotId as any)
          ? ((effectiveSlotRotOffsets as any)?.[p.slotId]?.[rot6] ?? { dx: 0, dy: 0 })
          : { dx: 0, dy: 0 };

        // Slot offset strategy:
        // - Default: template-space tweak (no rotation)
        // - M1..M4 (Middle): rotate with tile orientation so the correction stays attached to the tile as rot changes by SEED.
        const slot0Dx = (manualBySlot.dx ?? 0) + (manualBySlotRot.dx ?? 0);
        const slot0Dy = (manualBySlot.dy ?? 0) + (manualBySlotRot.dy ?? 0);
        const isMiddleSlotRotOffset = accepts0 === "MIDDLE" && MIDDLE_STABLE_BBOX_SLOTS.has(p.slotId as any);
        const rotatedSlot = isMiddleSlotRotOffset ? rotateOffset(slot0Dx, slot0Dy, tileDeg) : { dx: slot0Dx, dy: slot0Dy };
        const slotDx = rotatedSlot.dx;
        const slotDy = rotatedSlot.dy;

        // Accepts offset:
        // - SMALL: rotate with tile orientation (image-space tweak)
        // - LARGE/MIDDLE: do NOT rotate (template/slot-space tweak) to keep fixed positions across SEED rotations
        const acceptsRotDeg = accepts0 === "SMALL" ? tileDeg : 0;
        const rotatedAccepts = rotateOffset(manualByAccepts.dx ?? 0, manualByAccepts.dy ?? 0, acceptsRotDeg);

        const dx = slotDx + rotatedAccepts.dx;
        const dy = slotDy + rotatedAccepts.dy;

        const tx = fmtNum(x + drawOffsetX + dx);
        const ty = fmtNum(y + drawOffsetY + dy);

        const tdeg = fmtNum(tileDeg, 6);
        return {
          slotId: p.slotId,
          sectorId: p.sectorId,
          rot: p.rot,
          rot30: p.rot30 ?? 0,
          accepts0,
          img,
          x,
          y,
          w: drawW,
          h: drawH,
          offsetX: drawOffsetX,
          offsetY: drawOffsetY,
          // debug/useful: resolved translation components
          dx,
          dy,
          tileDeg,
          tx,
          ty,
          tdeg,
        };
      })
      .filter(Boolean) as Array<{
      slotId: string;
      sectorId: string;
      rot: number;
      rot30: number;
      accepts0: "LARGE" | "MIDDLE" | "SMALL";
      img: string;
      x: number;
      y: number;
      w: number;
      h: number;
      offsetX: number;
      offsetY: number;
      dx: number;
      dy: number;
      tileDeg: number;
      tx: number;
      ty: number;
      tdeg: number;
    }>;
  }, [
    placement,
    slotById,
    sectorImgById,
    boxByKey,
    viewRot,
    hexSize,
    rotateOffsetDegByAccepts,
    inflateByAccepts,
    scaleByAccepts,
    showDebug,
    imgOffsetByAccepts,
    imgOffsetBySlotId,
    rotOffsetsBySlotId,
    editAcceptsOffsets,
    editSlotOffsets,
    editSlotRotOffsets,
  ]);

  const bounds = React.useMemo(() => {
    // include tile extents and apply viewAngle rotation so bounds remain correct even when viewAngle != 0
    const pts: Array<{ x: number; y: number }> = [];
    for (const t of tileItems) {
      const center = rotatePoint(t.tx, t.ty, viewAngleDeg);
      const hw = t.w / 2;
      const hh = t.h / 2;
      const totalDeg = viewAngleDeg + t.tdeg;
      // 4 corners of the tile image box
      const corners = [
        { x: -hw, y: -hh },
        { x: hw, y: -hh },
        { x: hw, y: hh },
        { x: -hw, y: hh },
      ];
      for (const c of corners) {
        const rc = rotatePoint(c.x, c.y, totalDeg);
        pts.push({ x: center.x + rc.x, y: center.y + rc.y });
      }
    }
    return computeBounds(pts, effectivePad);
  }, [tileItems, viewAngleDeg, effectivePad]);

  const viewBox = `${fmtNum(bounds.minX)} ${fmtNum(bounds.minY)} ${bounds.maxX - bounds.minX} ${bounds.maxY - bounds.minY}`;

  return (
    <div style={{ width: "100%", height: "100%" }}>
      <div style={{ display: "flex", gap: 16, alignItems: "center", padding: 12 }}>
        <div style={{ fontWeight: 700 }}>
          {template.label} <span style={{ fontWeight: 400, opacity: 0.7 }}>({template.templateId})</span>
        </div>
        <div style={{ opacity: 0.8 }}>
          players={template.playerCount} / expansion={template.expansion} / slots={template.slots.length}
          {" / "}viewRot={viewRot} viewAngle={viewAngleDeg}° / hexSize={hexSize}
        </div>

        <div style={{ marginLeft: "auto", display: "flex", alignItems: "center", gap: 12 }}>
          <label style={{ display: "flex", alignItems: "center", gap: 6, cursor: "pointer", userSelect: "none" }}>
            <input type="checkbox" checked={showDebug} onChange={(e) => setShowDebug(e.target.checked)} />
            <span style={{ opacity: 0.85 }}>Debug</span>
          </label>
        </div>
      </div>

      {showDebug && (
        <div style={{ padding: 12, display: "flex", gap: 16, flexWrap: "wrap", alignItems: "flex-start" }}>
          <div style={{ minWidth: 320, padding: 12, border: "1px solid rgba(255,255,255,0.12)", borderRadius: 10 }}>
            <div style={{ fontWeight: 700, marginBottom: 8, opacity: 0.9 }}>Offset Editor</div>

            <div style={{ display: "grid", gridTemplateColumns: "120px 1fr", gap: 8, alignItems: "center" }}>
              <div style={{ opacity: 0.8 }}>SlotId</div>
              <select
                value={selectedSlotId}
                onChange={(e) => setSelectedSlotId(e.target.value)}
                style={{
                  padding: "6px 8px",
                  borderRadius: 8,
                  background: "rgba(255,255,255,0.06)",
                  color: "#e5e7eb",
                  border: "1px solid rgba(255,255,255,0.12)",
                }}
              >
                {template.slots
                  .map((s) => String(s.slotId))
                  .sort()
                  .map((sid) => (
                    <option key={sid} value={sid}>
                      {sid}
                    </option>
                  ))}
              </select>

              <div style={{ opacity: 0.8 }}>dx / dy (px)</div>
              <div style={{ display: "flex", gap: 8 }}>
                <input
                  type="number"
                  value={(editSlotOffsets[selectedSlotId]?.dx ?? 0) as any}
                  onChange={(e) =>
                    setEditSlotOffsets((prev) => ({
                      ...prev,
                      [selectedSlotId]: { dx: Number(e.target.value), dy: prev[selectedSlotId]?.dy ?? 0 },
                    }))
                  }
                  style={{
                    width: 100,
                    padding: "6px 8px",
                    borderRadius: 8,
                    background: "rgba(255,255,255,0.06)",
                    color: "#e5e7eb",
                    border: "1px solid rgba(255,255,255,0.12)",
                  }}
                />
                <input
                  type="number"
                  value={(editSlotOffsets[selectedSlotId]?.dy ?? 0) as any}
                  onChange={(e) =>
                    setEditSlotOffsets((prev) => ({
                      ...prev,
                      [selectedSlotId]: { dx: prev[selectedSlotId]?.dx ?? 0, dy: Number(e.target.value) },
                    }))
                  }
                  style={{
                    width: 100,
                    padding: "6px 8px",
                    borderRadius: 8,
                    background: "rgba(255,255,255,0.06)",
                    color: "#e5e7eb",
                    border: "1px solid rgba(255,255,255,0.12)",
                  }}
                />
                <button
                  onClick={() => setEditSlotOffsets((prev) => ({ ...prev, [selectedSlotId]: { dx: 0, dy: 0 } }))}
                  style={{
                    padding: "6px 10px",
                    borderRadius: 8,
                    border: "1px solid rgba(255,255,255,0.12)",
                    background: "rgba(255,255,255,0.06)",
                    color: "#e5e7eb",
                    cursor: "pointer",
                  }}
                >
                  Reset
                </button>
              </div>
            </div>

            <div style={{ marginTop: 10, display: "flex", gap: 8, flexWrap: "wrap" }}>
              {[
                ["←", -1, 0],
                ["→", +1, 0],
                ["↑", 0, -1],
                ["↓", 0, +1],
                ["←5", -5, 0],
                ["→5", +5, 0],
                ["↑5", 0, -5],
                ["↓5", 0, +5],
              ].map(([label, dx, dy]) => (
                <button
                  key={String(label)}
                  onClick={() =>
                    setEditSlotOffsets((prev) => ({
                      ...prev,
                      [selectedSlotId]: {
                        dx: (prev[selectedSlotId]?.dx ?? 0) + (dx as number),
                        dy: (prev[selectedSlotId]?.dy ?? 0) + (dy as number),
                      },
                    }))
                  }
                  style={{
                    padding: "6px 10px",
                    borderRadius: 8,
                    border: "1px solid rgba(255,255,255,0.12)",
                    background: "rgba(255,255,255,0.06)",
                    color: "#e5e7eb",
                    cursor: "pointer",
                  }}
                >
                  {label}
                </button>
              ))}
            </div>
          </div>

          <div style={{ minWidth: 320, padding: 12, border: "1px solid rgba(255,255,255,0.12)", borderRadius: 10 }}>
            <div style={{ fontWeight: 700, marginBottom: 8, opacity: 0.9 }}>Accepts Offset</div>

            <div style={{ display: "grid", gridTemplateColumns: "120px 1fr", gap: 8, alignItems: "center" }}>
              <div style={{ opacity: 0.8 }}>Accepts</div>
              <select
                value={selectedAccepts}
                onChange={(e) => setSelectedAccepts(e.target.value as any)}
                style={{
                  padding: "6px 8px",
                  borderRadius: 8,
                  background: "rgba(255,255,255,0.06)",
                  color: "#e5e7eb",
                  border: "1px solid rgba(255,255,255,0.12)",
                }}
              >
                <option value="LARGE">LARGE</option>
                <option value="MIDDLE">MIDDLE</option>
                <option value="SMALL">SMALL</option>
              </select>

              <div style={{ opacity: 0.8 }}>dx / dy (px)</div>
              <div style={{ display: "flex", gap: 8 }}>
                <input
                  type="number"
                  value={(editAcceptsOffsets[selectedAccepts]?.dx ?? 0) as any}
                  onChange={(e) =>
                    setEditAcceptsOffsets((prev) => ({
                      ...prev,
                      [selectedAccepts]: { dx: Number(e.target.value), dy: prev[selectedAccepts]?.dy ?? 0 },
                    }))
                  }
                  style={{
                    width: 100,
                    padding: "6px 8px",
                    borderRadius: 8,
                    background: "rgba(255,255,255,0.06)",
                    color: "#e5e7eb",
                    border: "1px solid rgba(255,255,255,0.12)",
                  }}
                />
                <input
                  type="number"
                  value={(editAcceptsOffsets[selectedAccepts]?.dy ?? 0) as any}
                  onChange={(e) =>
                    setEditAcceptsOffsets((prev) => ({
                      ...prev,
                      [selectedAccepts]: { dx: prev[selectedAccepts]?.dx ?? 0, dy: Number(e.target.value) },
                    }))
                  }
                  style={{
                    width: 100,
                    padding: "6px 8px",
                    borderRadius: 8,
                    background: "rgba(255,255,255,0.06)",
                    color: "#e5e7eb",
                    border: "1px solid rgba(255,255,255,0.12)",
                  }}
                />
                <button
                  onClick={() => setEditAcceptsOffsets((prev) => ({ ...prev, [selectedAccepts]: { dx: 0, dy: 0 } }))}
                  style={{
                    padding: "6px 10px",
                    borderRadius: 8,
                    border: "1px solid rgba(255,255,255,0.12)",
                    background: "rgba(255,255,255,0.06)",
                    color: "#e5e7eb",
                    cursor: "pointer",
                  }}
                >
                  Reset
                </button>
              </div>
            </div>
          </div>

          <div style={{ flex: 1, minWidth: 360, padding: 12, border: "1px solid rgba(255,255,255,0.12)", borderRadius: 10 }}>
            <div style={{ fontWeight: 700, marginBottom: 8, opacity: 0.9 }}>Export</div>
            <textarea
              value={exportOffsetsJson}
              readOnly
              rows={10}
              style={{
                width: "100%",
                padding: 10,
                borderRadius: 10,
                background: "rgba(0,0,0,0.35)",
                color: "#e5e7eb",
                border: "1px solid rgba(255,255,255,0.12)",
                fontFamily: "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
                fontSize: 12,
              }}
            />
            <div style={{ marginTop: 8, display: "flex", gap: 8, flexWrap: "wrap" }}>
              <button
                onClick={async () => {
                  try {
                    await navigator.clipboard.writeText(exportOffsetsJson);
                  } catch {}
                }}
                style={{
                  padding: "6px 10px",
                  borderRadius: 8,
                  border: "1px solid rgba(255,255,255,0.12)",
                  background: "rgba(255,255,255,0.06)",
                  color: "#e5e7eb",
                  cursor: "pointer",
                }}
              >
                Copy JSON
              </button>
              <button
                onClick={() => {
                  setEditAcceptsOffsets(imgOffsetByAccepts);
                  setEditSlotOffsets(imgOffsetBySlotId);
                }}
                style={{
                  padding: "6px 10px",
                  borderRadius: 8,
                  border: "1px solid rgba(255,255,255,0.12)",
                  background: "rgba(255,255,255,0.06)",
                  color: "#e5e7eb",
                  cursor: "pointer",
                }}
              >
                Revert to Props
              </button>
            </div>

            <div style={{ marginTop: 10, fontWeight: 700, opacity: 0.9 }}>Import</div>
            <textarea
              value={importJson}
              onChange={(e) => setImportJson(e.target.value)}
              rows={6}
              placeholder='Paste JSON here (e.g. {"imgOffsetByAccepts":{...},"imgOffsetBySlotId":{...}})'
              style={{
                width: "100%",
                padding: 10,
                borderRadius: 10,
                background: "rgba(0,0,0,0.35)",
                color: "#e5e7eb",
                border: "1px solid rgba(255,255,255,0.12)",
                fontFamily: "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
                fontSize: 12,
                marginTop: 8,
              }}
            />
            <div style={{ marginTop: 8, display: "flex", gap: 8, flexWrap: "wrap", alignItems: "center" }}>
              <button
                onClick={applyImportJson}
                style={{
                  padding: "6px 10px",
                  borderRadius: 8,
                  border: "1px solid rgba(255,255,255,0.12)",
                  background: "rgba(255,255,255,0.06)",
                  color: "#e5e7eb",
                  cursor: "pointer",
                }}
              >
                Apply Import
              </button>
              <button
                onClick={() => {
                  setImportJson("");
                  setImportError(null);
                }}
                style={{
                  padding: "6px 10px",
                  borderRadius: 8,
                  border: "1px solid rgba(255,255,255,0.12)",
                  background: "rgba(255,255,255,0.06)",
                  color: "#e5e7eb",
                  cursor: "pointer",
                }}
              >
                Clear
              </button>
              {importError && <span style={{ color: "#fca5a5" }}>Import error: {importError}</span>}
            </div>
          </div>
        </div>
      )}

      <svg
  width="100%"
  height="100%"
  viewBox={viewBox}
  preserveAspectRatio="xMinYMin meet"   // ★左上寄せ
  style={{ background: "#ffffff", display: "block" }}>
        <g transform={`rotate(${viewAngleDeg})`}>
          {tileItems.map((t) => (
            <g
              key={`${t.slotId}:${t.sectorId}:${t.rot}:${t.rot30 ?? 0}`}
              transform={`translate(${t.tx},${t.ty}) rotate(${t.tdeg})`}
            >
              {t.img ? (
                <image href={t.img} x={-t.w / 2} y={-t.h / 2} width={t.w} height={t.h} preserveAspectRatio="xMidYMid meet" />
              ) : null}

              {showDebug && (
                <g>
                  {/* slot center marker (after translate, 0,0 is slot center) */}
                  <circle cx={0} cy={0} r={4} fill="none" stroke="rgba(255,255,0,0.9)" strokeWidth={2} />
                  <line x1={-10} y1={0} x2={10} y2={0} stroke="rgba(255,255,0,0.7)" strokeWidth={1} />
                  <line x1={0} y1={-10} x2={0} y2={10} stroke="rgba(255,255,0,0.7)" strokeWidth={1} />
                  {/* image bounds */}
                  <rect
                    x={-t.w / 2}
                    y={-t.h / 2}
                    width={t.w}
                    height={t.h}
                    fill="none"
                    stroke="rgba(0,255,255,0.55)"
                    strokeWidth={2}
                    rx={10}
                  />
                </g>
              )}

              {showLabels && (
                <g transform={`rotate(${-t.tileDeg})`}>
                  <rect x={-92} y={t.h / 2 - 32} width={184} height={22} rx={6} fill="rgba(0,0,0,0.55)" />
                  <text x={0} y={t.h / 2 - 16} textAnchor="middle" fontSize={12} fill="#e5e7eb">
                    {t.slotId} / {t.sectorId} / r{t.rot}
                    {t.rot30 ? ` +${t.rot30}*30°` : ""}
                  </text>
                </g>
              )}
            </g>
          ))}
        </g>
      </svg>
    </div>
  );
}

// NOTE: 既存実装にあった参照（OFFSET_JSON_REPLACE_ME）を壊さないためのダミー。
// 実プロジェクト側で置換済ならこの定義は不要です。
// eslint-disable-next-line @typescript-eslint/no-unused-vars
const OFFSET_JSON_REPLACE_ME: any = {};
