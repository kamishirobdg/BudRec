// src/gaia/eval/extractForEval.ts
//
// extractForEval = 評価入力の唯一SSOT
// - LogicalMapから評価対象セルを抽出
// - BASIC_PLANET_TYPESのみ対象
// - GAIA / TRANSDIM / proto / asteroid除外
// - placementHashを必ず保持
//

import type { LogicalMap } from "../logicalMap/buildLogicalMap";

export type ExtractedForEval = {
  templateId: string;
  placementHash: string;

  normalPlanetCells: {
    key: string;
    planetType: string;
    q: number;
    r: number;
  }[];

  allPlanetCells: {
    key: string;
    planetType: string;
    q: number;
    r: number;
  }[];
};

const BASIC_PLANET_TYPES = new Set([
  "TERRA",
  "DESERT",
  "OXIDE",
  "VOLCANIC",
  "ICE",
  "SWAMP",
  "TITANIUM",
  "TRANSDIM", // 除外対象だが型定義上残す
  "GAIA",     // 除外対象
]);

function isNormalPlanet(type: string) {
  if (!type) return false;
  if (type === "GAIA") return false;
  if (type === "TRANSDIM") return false;
  return BASIC_PLANET_TYPES.has(type);
}

export function extractForEval(logical: LogicalMap): ExtractedForEval {
  const normalPlanetCells: ExtractedForEval["normalPlanetCells"] = [];
  const allPlanetCells: ExtractedForEval["allPlanetCells"] = [];

  for (const [key, cell] of logical.cellsByKey.entries()) {
    const type = String(cell.planetType ?? "");

    if (!type) continue;

    allPlanetCells.push({
      key,
      planetType: type,
      q: cell.q,
      r: cell.r,
    });

    if (!isNormalPlanet(type)) continue;

    normalPlanetCells.push({
      key,
      planetType: type,
      q: cell.q,
      r: cell.r,
    });
  }

  return {
    templateId: logical.templateId,
    placementHash: logical.placementHash, // ★必ず通す
    normalPlanetCells,
    allPlanetCells,
  };
}
