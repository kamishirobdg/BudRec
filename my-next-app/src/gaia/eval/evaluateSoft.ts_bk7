// src/gaia/eval/evaluateSoft.ts
//
// Soft評価（更新版）
// - すべての評価軸は「惑星種別別（基本7色）の寄与」に分解して返す
// - マップ全体の最終評価（score）は PlanetTypeTotals の乖離（ばらつき）のみから導出する
//   例: score = - wImbalance * std(PlanetTypeTotals)
// - ScoutCore は後段で再定義予定のため、現段階では “軸枠のみ” 提供（0寄与）
//
import type { ExtractedForEval, PlanetKind } from "./extractForEval";
import { axialDistance } from "../hex";

export type PlanetType =
  | "BLACK"
  | "BLUE"
  | "BROWN"
  | "ORANGE"
  | "RED"
  | "WHITE"
  | "YELLOW";

export type AxisByType = Record<PlanetType, number>;
export type CountByType = Record<PlanetType, number>;

export type SoftParams = {
  // weights (軸→惑星種別寄与)
  wOuter: number;          // outer: -wOuter * count
  wTouch: number;          // touch: -wTouch * count
  wScout: number;          // scout: +wScout * Σ base(d)
  wScoutCore?: number;     // 後で再定義予定（現段階は0推奨）

  // 全体評価（乖離）
  wImbalance: number;
  imbalanceMetric?: "std" | "range"; // default: std

  // Scout距離
  scoutRadius: number;     // 推奨: 2〜4
};

export type SoftBreakdown = {
  // 軸別・惑星種別別寄与（必須）
  axesByType: {
    outer: AxisByType;
    touch: AxisByType;
    scout: AxisByType;
    scoutCore: AxisByType; // 再定義予定（現状は0）
  };

  // 軸を合算した惑星種別別評価値合計（必須）
  planetTypeTotals: AxisByType;

  // 乖離評価（必須）
  imbalance: {
    metric: "std" | "range";
    value: number;
    score: number; // = -wImbalance * value
  };

  // 監査（表示用）
  audit: {
    outerCountByType: CountByType;
    touchCountByType: CountByType;

    scout: {
      radius: number;
      // Scoutセルごとの近傍寄与（惑星種別別）
      perScout: Array<{
        scoutKey: string;
        byType: AxisByType;
        total: number;
      }>;
      byType: AxisByType; // scout合算（axesByType.scout と同じ）
    };
  };

  // debug（既存の extracted.audit をそのまま載せる）
  debug?: any;
};

export type SoftEvalResult = {
  // マップ全体の評価（SSOT: 乖離スコアのみ）
  score: number;
  breakdown: SoftBreakdown;
};

const PLANET_TYPES: PlanetType[] = [
  "BLACK",
  "BLUE",
  "BROWN",
  "ORANGE",
  "RED",
  "WHITE",
  "YELLOW",
];

function zeroAxis(): AxisByType {
  return {
    BLACK: 0,
    BLUE: 0,
    BROWN: 0,
    ORANGE: 0,
    RED: 0,
    WHITE: 0,
    YELLOW: 0,
  };
}

function num(v: any, fallback: number): number {
  const n = typeof v === "number" ? v : Number(v);
  return Number.isFinite(n) ? n : fallback;
}

function clampInt(v: any, fallback: number, min: number, max: number): number {
  const n = Math.floor(num(v, fallback));
  return Math.max(min, Math.min(max, n));
}

function addAxis(a: AxisByType, b: AxisByType): AxisByType {
  const out = zeroAxis();
  for (const t of PLANET_TYPES) out[t] = (a[t] ?? 0) + (b[t] ?? 0);
  return out;
}

function axisValues(a: AxisByType): number[] {
  return PLANET_TYPES.map((t) => a[t] ?? 0);
}

function std(values: number[]): number {
  if (values.length === 0) return 0;
  const mean = values.reduce((s, x) => s + x, 0) / values.length;
  const v = values.reduce((s, x) => s + (x - mean) * (x - mean), 0) / values.length;
  return Math.sqrt(v);
}

function range(values: number[]): number {
  if (values.length === 0) return 0;
  let mn = Infinity;
  let mx = -Infinity;
  for (const x of values) {
    if (x < mn) mn = x;
    if (x > mx) mx = x;
  }
  return mx - mn;
}

function toPlanetType(kind?: PlanetKind, colorKey?: string): PlanetType | null {
  // extractForEval 側で colorKey は基本7色に正規化されている想定
  const s = (colorKey ?? kind ?? "").toString().toUpperCase();
  if (s === "BLACK") return "BLACK";
  if (s === "BLUE") return "BLUE";
  if (s === "BROWN") return "BROWN";
  if (s === "ORANGE") return "ORANGE";
  if (s === "RED") return "RED";
  if (s === "WHITE") return "WHITE";
  if (s === "YELLOW") return "YELLOW";
  return null;
}

function scoutValue(d: number, wScout: number, R: number): number {
  // SSOT: d=1 で wScout、1セル離れるごとに -1、R超過は0
  if (d < 1 || d > R) return 0;
  const v = wScout - (d - 1);
  return v > 0 ? v : 0;
}

export function evaluateSoft(extracted: ExtractedForEval, params: SoftParams): SoftEvalResult {
  const wOuter = num(params.wOuter, 0);
  const wTouch = num(params.wTouch, 0);
  const wScout = num(params.wScout, 0);
  const wScoutCore = num(params.wScoutCore, 0); // 現段階は0推奨（再定義予定）
  const wImbalance = num(params.wImbalance, 0);

  const metric: "std" | "range" =
    (params.imbalanceMetric === "range" || params.imbalanceMetric === "std")
      ? params.imbalanceMetric
      : "std";

  const scoutRadius = clampInt(params.scoutRadius, 2, 0, 6);

  // -------------------------
  // outer / touch（種別別）
  // -------------------------
  const outerCountByType: CountByType = zeroAxis();
  const touchCountByType: CountByType = zeroAxis();
  const outerHits: any[] = [];
  const touchHits: any[] = [];

  for (const p of extracted.normalPlanetCells) {
    const t = toPlanetType(p.planetKind as any, (p as any).colorKey);
    if (!t) continue;
    if (extracted.outerCells.has(p.key)) { outerCountByType[t] += 1; outerHits.push({ cellKey: p.key, planetType: t }); }
    if (extracted.touchCells.has(p.key)) { touchCountByType[t] += 1; touchHits.push({ cellKey: p.key, planetType: t }); }
  }

  const outerAxis: AxisByType = zeroAxis();
  const touchAxis: AxisByType = zeroAxis();
  for (const t of PLANET_TYPES) {
    outerAxis[t] = -wOuter * outerCountByType[t];
    touchAxis[t] = -wTouch * touchCountByType[t];
  }

  // -------------------------
  // scout（種別別）
  // -------------------------
  const scoutAxis: AxisByType = zeroAxis();
  const perScout: Array<{ scoutKey: string; byType: AxisByType; total: number }> = [];
  const scoutHits: any[] = [];

  for (const s of extracted.scoutCells) {
    const byType = zeroAxis();
    for (const p of extracted.normalPlanetCells) {
      const t = toPlanetType(p.planetKind as any, (p as any).colorKey);
      if (!t) continue;

      const d = axialDistance(s.q, s.r, p.q, p.r);
      const contrib = scoutValue(d, wScout, scoutRadius);
      if (contrib <= 0) continue;

      // contrib computed above
      byType[t] += contrib;
      scoutAxis[t] += contrib;
      scoutHits.push({ scoutKey: s.key, planetKey: p.key, planetType: t, distance: d, value: contrib });
    }
    const total = axisValues(byType).reduce((a, b) => a + b, 0);
    perScout.push({ scoutKey: s.key, byType, total });
  }

  // -------------------------
  // scoutCore（後で再定義予定）
  // -------------------------
  const scoutCoreAxis: AxisByType = zeroAxis();
  if (wScoutCore !== 0) {
    // 現段階では “0寄与” を前提。将来ここを実装して種別別に積む。
    for (const t of PLANET_TYPES) scoutCoreAxis[t] = 0;
  }

  // -------------------------
  // totals & imbalance
  // -------------------------
  const planetTypeTotals = addAxis(addAxis(outerAxis, touchAxis), addAxis(scoutAxis, scoutCoreAxis));

  const values = axisValues(planetTypeTotals);
  const imbalanceValue = metric === "range" ? range(values) : std(values);
  const imbalanceScore = -wImbalance * imbalanceValue;

  const breakdown: SoftBreakdown = {
    axesByType: {
      outer: outerAxis,
      touch: touchAxis,
      scout: scoutAxis,
      scoutCore: scoutCoreAxis,
    },
    planetTypeTotals,
    imbalance: {
      metric,
      value: imbalanceValue,
      score: imbalanceScore,
    },
    audit: {
      outerCountByType,
      touchCountByType,
      outerHits,
      touchHits,
      scout: {
        radius: scoutRadius,
        perScout,
        byType: scoutAxis,
        scoutHits,
      },
    },
    debug: (extracted as any).audit,
  };

  // SSOT: マップ全体評価は「乖離」のみ
  return {
    score: imbalanceScore,
    breakdown,
  };
}
