// src/gaia/eval/evaluateSoft.ts
//
// Soft評価（LogicalMap / ExtractedForEval SSOT）
//
// - dispersion: 既存思想（色ごと重心→距離）
// - outer/touch: 固定集合 × 通常惑星（基本7色）
// - ScoutCore: 「Scout に近い通常惑星ほど高評価」
//   ※ Specialタグ等は存在しない前提。scout:* tags をSSOTにする。
//
import type { ExtractedForEval, PlanetKind } from "./extractForEval";
import { axialDistance } from "../hex";

export type SoftParams = {
  wOuter: number;
  wTouch: number;

  wFavor: number;
  wAvoid: number;

  wDispersion: number;

  // ScoutCore（旧SC相当）
  wScoutCore?: number;     // 未指定なら 0（NaN回避）
  scoutRadius?: number;    // 未指定なら 2
  // 将来拡張用（現状固定）
  scoutTargets?: "NORMAL_PLANETS";

  favorTargets: PlanetKind[];
  avoidTargets: PlanetKind[];
};

export type DispersionByColor = {
  color: string;
  count: number;
  centroidQ: number | null;
  centroidR: number | null;
  avgDistToCentroid: number | null;
  varDistToCentroid: number | null;
};

export type SoftBreakdown = {
  debug?: any;

  dispersion: {
    raw: number;
    score: number;
    byColor: DispersionByColor[];
  };

  scoutCore: {
    scoutCells: number;
    radius: number;
    // Scoutごとの「近傍通常惑星の加点合計」(Σ(radius+1-d))
    perScout: Array<{ scoutKey: string; points: number; nearCount: number }>;
    raw: number;
    score: number;
  };

  outerTouchPenalty: {
    outerNormalCount: number;
    touchNormalCount: number;
    penaltyOuter: number;
    penaltyTouch: number;
    penaltyTotal: number;
  };

  favor: {
    targets: PlanetKind[];
    sumPoints: number;
    score: number;
  };

  avoid: {
    targets: PlanetKind[];
    sumPoints: number;
    score: number;
  };
};

export type SoftEvalResult = {
  score: number;
  breakdown: SoftBreakdown;
};

function num(v: any, fallback: number): number {
  const n = typeof v === "number" ? v : Number(v);
  return Number.isFinite(n) ? n : fallback;
}

export function evaluateSoft(extracted: ExtractedForEval, params: SoftParams): SoftEvalResult {
  // --- weights (NaN安全化) ---
  const wDispersion = num(params.wDispersion, 0);
  const wOuter = num(params.wOuter, 0);
  const wTouch = num(params.wTouch, 0);
  const wScoutCore = num(params.wScoutCore, 0);
  const radius = Math.max(0, Math.floor(num(params.scoutRadius, 2)));

  // --- Dispersion (centroid-based) ---
  const dispersionByColor: DispersionByColor[] = [];
  let dispersionRaw = 0;

  for (const [color, arr] of Object.entries(extracted.normalPlanetsByColor)) {
    const n = arr.length;
    if (n === 0) {
      dispersionByColor.push({
        color,
        count: 0,
        centroidQ: null,
        centroidR: null,
        avgDistToCentroid: null,
        varDistToCentroid: null,
      });
      continue;
    }

    const cq = arr.reduce((s, c) => s + c.q, 0) / n;
    const cr = arr.reduce((s, c) => s + c.r, 0) / n;

    const dists = arr.map((c) => axialDistance(c.q, c.r, cq, cr));
    const avg = dists.reduce((s, x) => s + x, 0) / n;
    const variance = dists.reduce((s, x) => s + (x - avg) * (x - avg), 0) / n;

    dispersionByColor.push({
      color,
      count: n,
      centroidQ: cq,
      centroidR: cr,
      avgDistToCentroid: avg,
      varDistToCentroid: variance,
    });

    // raw は「色ごとの平均距離の合計」
    dispersionRaw += avg;
  }
  const dispersionScore = wDispersion * dispersionRaw;

  // --- ScoutCore (旧SC: Scoutに近い惑星ほど高評価) ---
  // 加点: d<=radius のとき (radius+1-d)。近いほど大きい。
  // raw: Scout全体の加点合計
  const perScout: Array<{ scoutKey: string; points: number; nearCount: number }> = [];
  let scoutRaw = 0;

  for (const s of extracted.scoutCells) {
    let pts = 0;
    let near = 0;
    for (const p of extracted.normalPlanetCells) {
      const d = axialDistance(s.q, s.r, p.q, p.r);
      if (d <= radius) {
        near += 1;
        pts += (radius + 1 - d);
      }
    }
    perScout.push({ scoutKey: s.key, points: pts, nearCount: near });
    scoutRaw += pts;
  }
  const scoutCoreScore = wScoutCore * scoutRaw;

  // --- Outer / Touch ---
  const outerNormalCount = extracted.audit.outerNormalCount;
  const touchNormalCount = extracted.audit.touchNormalCount;
  const penaltyOuter = -wOuter * outerNormalCount;
  const penaltyTouch = -wTouch * touchNormalCount;
  const penaltyTotal = penaltyOuter + penaltyTouch;

  // --- Favor / Avoid (points 未配線のため 0) ---
  const favor = evalTargets(extracted, params.favorTargets, num(params.wFavor, 0), +1);
  const avoid = evalTargets(extracted, params.avoidTargets, num(params.wAvoid, 0), -1);

  const score = dispersionScore + scoutCoreScore + penaltyTotal + favor.score + avoid.score;

  return {
    score,
    breakdown: {
      debug: extracted.audit,

      dispersion: { raw: dispersionRaw, score: dispersionScore, byColor: dispersionByColor },

      scoutCore: {
        scoutCells: extracted.scoutCells.length,
        radius,
        perScout,
        raw: scoutRaw,
        score: scoutCoreScore,
      },

      outerTouchPenalty: {
        outerNormalCount,
        touchNormalCount,
        penaltyOuter,
        penaltyTouch,
        penaltyTotal,
      },

      favor,
      avoid,
    },
  };
}

function evalTargets(
  extracted: ExtractedForEval,
  targets: PlanetKind[],
  w: number,
  sign: 1 | -1
): { targets: PlanetKind[]; sumPoints: number; score: number } {
  const set = new Set(targets);
  let sum = 0;

  for (const cell of extracted.planetCells) {
    if (!cell.planetKind) continue;
    if (!set.has(cell.planetKind)) continue;
    sum += 0; // points 未配線
  }

  return { targets, sumPoints: sum, score: sign * w * sum };
}
