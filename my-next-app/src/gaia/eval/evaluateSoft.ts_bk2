// src/gaia/eval/evaluateSoft.ts
import type { ExtractedForEval, PlanetKind } from "./extractForEval";
import { axialDistance } from "../hex";

export type SoftParams = {
  wOuter: number;
  wTouch: number;
  wFavor: number;
  wAvoid: number;
  wDispersion: number;
  favorTargets: PlanetKind[];
  avoidTargets: PlanetKind[];
};

export type DispersionByColor = {
  color: string;
  count: number;
  centroidQ: number | null;
  centroidR: number | null;
  avgDistToCentroid: number | null;
  varDistToCentroid: number | null;
};

export type SoftBreakdown = {
  dispersion: {
    score: number;
    byColor: DispersionByColor[];
  };
  outerTouchPenalty: {
    outerNormalCount: number;
    touchNormalCount: number;
    penaltyOuter: number;
    penaltyTouch: number;
    penaltyTotal: number;
  };
  favor: {
    targets: PlanetKind[];
    sumPoints: number;
    score: number;
  };
  avoid: {
    targets: PlanetKind[];
    sumPoints: number;
    score: number;
  };
};

export type SoftEvalResult = {
  score: number;
  breakdown: SoftBreakdown;
};

export function evaluateSoft(extracted: ExtractedForEval, params: SoftParams): SoftEvalResult {
  // --- Dispersion (ported from legacy evaluate.ts) ---
  const dispersionByColor: DispersionByColor[] = [];
  let dispersionScore = 0;

  for (const [color, arr] of Object.entries(extracted.normalPlanetsByColor)) {
    const n = arr.length;
    if (n === 0) {
      dispersionByColor.push({
        color,
        count: 0,
        centroidQ: null,
        centroidR: null,
        avgDistToCentroid: null,
        varDistToCentroid: null,
      });
      continue;
    }

    const cq = arr.reduce((s, c) => s + c.q, 0) / n;
    const cr = arr.reduce((s, c) => s + c.r, 0) / n;

    const dists = arr.map((c) => axialDistance(c.q, c.r, cq, cr));
    const avg = dists.reduce((s, x) => s + x, 0) / n;
    const variance = dists.reduce((s, x) => s + (x - avg) * (x - avg), 0) / n;

    dispersionByColor.push({
      color,
      count: n,
      centroidQ: cq,
      centroidR: cr,
      avgDistToCentroid: avg,
      varDistToCentroid: variance,
    });

    // dispersion score: sum of avg distance per color
    dispersionScore += avg;
  }

  const dispersionScoreWeighted = params.wDispersion * dispersionScore;

  // --- Outer / Touch ---
  const outerNormalCount = extracted.audit.outerNormalCount;
  const touchNormalCount = extracted.audit.touchNormalCount;

  const penaltyOuter = -params.wOuter * outerNormalCount;
  const penaltyTouch = -params.wTouch * touchNormalCount;
  const penaltyTotal = penaltyOuter + penaltyTouch;

  // --- Favor / Avoid (still 0 until points are wired) ---
  const favor = evalTargets(extracted, params.favorTargets, params.wFavor, +1);
  const avoid = evalTargets(extracted, params.avoidTargets, params.wAvoid, -1);

  const score =
    dispersionScoreWeighted +
    penaltyTotal +
    favor.score +
    avoid.score;

  return {
    score,
    breakdown: {
      dispersion: {
        score: dispersionScoreWeighted,
        byColor: dispersionByColor,
      },
      outerTouchPenalty: {
        outerNormalCount,
        touchNormalCount,
        penaltyOuter,
        penaltyTouch,
        penaltyTotal,
      },
      favor,
      avoid,
    },
  };
}

function evalTargets(
  extracted: ExtractedForEval,
  targets: PlanetKind[],
  w: number,
  sign: 1 | -1
): { targets: PlanetKind[]; sumPoints: number; score: number } {
  const set = new Set(targets);
  let sum = 0;

  for (const cell of extracted.planetCells) {
    if (!cell.planetKind) continue;
    if (!set.has(cell.planetKind)) continue;
    sum += 0; // points 未配線
  }

  return { targets, sumPoints: sum, score: sign * w * sum };
}
