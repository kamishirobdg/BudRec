// src/gaia/search.ts
//
// SSOT search pipeline:
// seed -> (SSOT) placement -> buildLogicalMapFromPlacement -> extractForEval -> checkHardConstraints -> evaluateSoft -> Top-K
//
import type { SlotPlacement } from "./board/types";
import { makeSearchPlacementFromSeed } from "./ssot/searchPlacementConfig";
import { buildLogicalMapFromPlacement } from "./logicalMap/buildLogicalMap";

import { extractForEval, type ExtractedForEval } from "./eval/extractForEval";
import { checkHardConstraints, type HardFailReason } from "./constraints";
import { evaluateSoft, type SoftParams, type SoftEvalResult } from "./eval/evaluateSoft";
import { computePlacementHash } from "./ssot/placementHash";

// DEBUG switches (temporary)
// ★普段は必ず false
const DEBUG_DUMP_ALL_KEYS = false;
const DEBUG_DUMP_OUTER_AUDIT = false;

export type HardParams = {
  minSameColorDist: number;
  outerSameColorMax: number;
  centerMode: "NONE" | "CENTER_7_9" | "CENTER_8";
};

export type SearchOptions = {
  trials: number;
  keepTop: number;
  seedStart?: number;
  hard: HardParams;
  soft: SoftParams;
  yieldEvery?: number;
};

export type RankedResult = {
  seed: number;
  templateId: string;

  placement: SlotPlacement[];
  placementHash: string;

  score: number;
  breakdown: SoftEvalResult["breakdown"];

  audit: {
    placementHash: string;
    outerNormalCount: number;
    touchNormalCount: number;
  };

  hardSnapshot: HardParams;
  softSnapshot: SoftParams;
};

export type SearchDiagnostics = {
  trials: number;
  passedHard: number;
  hardFailBy: Record<HardFailReason, number>;
  options: SearchOptions;

  // DEBUG
  logicalMapAllKeys?: string[];
  outerAudit?: Array<{
    key: string;
    exists: boolean;
    kind?: string;
    tags: string[];
    planetType: string | null;
  }>;
};

function pushTopK(best: RankedResult[], cand: RankedResult, keepTop: number) {
  best.push(cand);
  best.sort((a, b) => b.score - a.score || a.seed - b.seed);
  if (best.length > keepTop) best.length = keepTop;
}

export async function runSearch(
  templateId: string,
  options: SearchOptions,
  onProgress?: (done: number, best: RankedResult[]) => void
): Promise<{ results: RankedResult[]; diagnostics: SearchDiagnostics }> {
  const seed0 = options.seedStart ?? 1;
  const yieldEvery = options.yieldEvery ?? 25;

  const hardFailBy: Record<HardFailReason, number> = {
    H1_MIN_SAME_COLOR_DIST: 0,
    H2_OUTER_COLOR_CAP: 0,
    H4_CENTER_LARGE_1_4: 0,
    BUILD_LOGICAL_MAP_FAILED: 0,
    EXTRACT_FAILED: 0,
  } as any;

  const best: RankedResult[] = [];
  let passedHard = 0;

  for (let i = 0; i < options.trials; i++) {
    const seed = seed0 + i;

    // 0) seed -> placement (SSOT)
    let placement: SlotPlacement[];
    try {
      const made = makeSearchPlacementFromSeed({ templateId, seed });
      placement = made.placement as any;
    } catch {
      hardFailBy.BUILD_LOGICAL_MAP_FAILED = (hardFailBy.BUILD_LOGICAL_MAP_FAILED ?? 0) + 1;
      if (onProgress && i % yieldEvery === 0) onProgress(i + 1, best);
      continue;
    }

    const placementHash = computePlacementHash(placement);

    // 1) LogicalMap（placement入力が正系統）
    let logicalMap: any;
    try {
      logicalMap = buildLogicalMapFromPlacement({ templateId, seed, placement });
    } catch {
      hardFailBy.BUILD_LOGICAL_MAP_FAILED = (hardFailBy.BUILD_LOGICAL_MAP_FAILED ?? 0) + 1;
      if (onProgress && i % yieldEvery === 0) onProgress(i + 1, best);
      continue;
    }

    // DEBUG: dump all keys (SSOT)
    if (DEBUG_DUMP_ALL_KEYS) {
      const allCellKeys = Array.from((logicalMap as any).cellsByKey?.keys?.() ?? []);
      console.log("=== LOGICALMAP ALL CELL KEYS ===", { seed, count: allCellKeys.length });

      return {
        results: [],
        diagnostics: {
          trials: options.trials,
          passedHard,
          hardFailBy,
          options,
          logicalMapAllKeys: allCellKeys,
        },
      };
    }

    // 2) Extract（評価SSOT生成） ★ここが今回の修正点
    let extracted: ExtractedForEval;
    try {
      extracted = extractForEval(logicalMap); // ← options.hard は渡さない（extractSSOT一本化）
    } catch {
      hardFailBy.EXTRACT_FAILED = (hardFailBy.EXTRACT_FAILED ?? 0) + 1;
      if (onProgress && i % yieldEvery === 0) onProgress(i + 1, best);
      continue;
    }

    // DEBUG: outer audit (existence on LogicalMap)
    if (DEBUG_DUMP_OUTER_AUDIT) {
      // outerCells の概念が extractForEval 側に無い場合があるので、
      // ここでは normalPlanetCells の key を監査対象にする（最低限の健全性確認）
      const outerAudit: any[] = [];
      for (const c of extracted.normalPlanetCells) {
        const key = c.key;
        const cell = (logicalMap as any).cellsByKey?.get?.(key);
        outerAudit.push({
          key,
          exists: !!cell,
          kind: cell?.kind,
          tags: cell?.tags ?? [],
          planetType: cell?.planetType ?? null,
        });
      }

      console.log("=== LOGICAL AUDIT (normal planets) ===", { seed, count: outerAudit.length });

      return {
        results: [],
        diagnostics: {
          trials: options.trials,
          passedHard,
          hardFailBy,
          options,
          outerAudit,
        },
      };
    }

    // 3) Hard（LogicalMap基準のまま）
    const hard = checkHardConstraints(extracted as any, placement as any, options.hard as any);
    if (!hard.pass) {
      for (const r of hard.reasons) {
        hardFailBy[r.reason] = (hardFailBy[r.reason] ?? 0) + 1;
      }
      if (onProgress && i % yieldEvery === 0) onProgress(i + 1, best);
      continue;
    }

    passedHard += 1;

    // 4) Soft
    const evaluation = evaluateSoft(extracted, options.soft);

    const outerNormalCount =
      (evaluation.breakdown as any)?.audit?.outerCountByType
        ? Object.values((evaluation.breakdown as any).audit.outerCountByType).reduce((a: any, b: any) => (a as any) + (b as any), 0)
        : 0;

    const touchNormalCount =
      (evaluation.breakdown as any)?.audit?.touchCountByType
        ? Object.values((evaluation.breakdown as any).audit.touchCountByType).reduce((a: any, b: any) => (a as any) + (b as any), 0)
        : 0;

    pushTopK(
      best,
      {
        seed,
        templateId,
        placement,
        placementHash,
        score: evaluation.score,
        breakdown: evaluation.breakdown,
        audit: {
          placementHash,
          outerNormalCount,
          touchNormalCount,
        },
        hardSnapshot: options.hard,
        softSnapshot: options.soft,
      },
      options.keepTop
    );

    if (options.keepTop === 1 && best.length >= 1) {
      return {
        results: best,
        diagnostics: {
          trials: options.trials,
          passedHard,
          hardFailBy,
          options,
        },
      };
    }

    if (onProgress && i % yieldEvery === 0) onProgress(i + 1, best);
  }

  return {
    results: best,
    diagnostics: {
      trials: options.trials,
      passedHard,
      hardFailBy,
      options,
    },
  };
}
