// src/gaia/search.ts
//
// SSOT search pipeline:
// seed -> buildLogicalMap -> extractForEval -> checkHardConstraints -> evaluateSoft -> Top-K
//
import { buildLogicalMap } from "./logicalMap/buildLogicalMap";
import { extractForEval, type HardParams } from "./eval/extractForEval";
import { checkHardConstraints, type HardFailReason } from "./constraints";
import { evaluateSoft, type SoftParams, type SoftEvalResult } from "./eval/evaluateSoft";

export type SearchOptions = {
  trials: number;
  keepTop: number;
  seedStart?: number; // 連番探索（未指定なら 1）
  hard: HardParams;
  soft: SoftParams;
  yieldEvery?: number;
};

export type RankedResult = {
  seed: number;
  score: number;
  breakdown: SoftEvalResult["breakdown"];
  audit: {
    outerNormalCount: number;
    touchNormalCount: number;
  };
  hardSnapshot: HardParams;
  softSnapshot: SoftParams;
};

export type SearchDiagnostics = {
  trials: number;
  passedHard: number;
  hardFailBy: Record<HardFailReason, number>;
  options: SearchOptions;
};

export async function runSearch(
  templateId: string,
  options: SearchOptions,
  onProgress?: (done: number, best: RankedResult[]) => void
): Promise<{ results: RankedResult[]; diagnostics: SearchDiagnostics }> {
  const hardFailBy: Record<HardFailReason, number> = {
    H1_MIN_DIST: 0,
    H2_OUTER_CAP: 0,
    H4_CENTER_LARGE14: 0,
  };

  const best: RankedResult[] = [];
  const yieldEvery = options.yieldEvery ?? 0;

  const seed0 = options.seedStart ?? 1;
  let passedHard = 0;

  for (let i = 0; i < options.trials; i++) {
    const seed = seed0 + i;

    // 1) LogicalMap（内部で placementFromSeed を呼ぶ）
    let logicalMap;
    try {
      logicalMap = buildLogicalMap({ seed, templateId });
    } catch {
      // templateId不一致などはここに来る
      if (onProgress && i % 25 === 0) onProgress(i + 1, best);
      continue;
    }

    // 2) Extract（評価SSOT生成）
    const extracted = extractForEval(logicalMap, options.hard);

    // 3) Hard
    const hard = checkHardConstraints(extracted, logicalMap.placement, options.hard);
    if (!hard.pass) {
      for (const r of hard.reasons) hardFailBy[r.reason] = (hardFailBy[r.reason] ?? 0) + 1;
      if (onProgress && i % 25 === 0) onProgress(i + 1, best);
      if (yieldEvery && i % yieldEvery === 0) await new Promise((r) => setTimeout(r, 0));
      continue;
    }
    passedHard++;

    // 4) Soft
    const soft = evaluateSoft(extracted, options.soft);

    // 5) Top-K
    best.push({
      seed,
      score: soft.score,
      breakdown: soft.breakdown,
      audit: extracted.audit,
      hardSnapshot: { ...options.hard },
      softSnapshot: { ...options.soft },
    });

    best.sort((a, b) => {
      if (b.score !== a.score) return b.score - a.score;
      if (a.audit.outerNormalCount !== b.audit.outerNormalCount) return a.audit.outerNormalCount - b.audit.outerNormalCount;
      if (a.audit.touchNormalCount !== b.audit.touchNormalCount) return a.audit.touchNormalCount - b.audit.touchNormalCount;
      return a.seed - b.seed;
    });
    if (best.length > options.keepTop) best.length = options.keepTop;

    if (onProgress && i % 25 === 0) onProgress(i + 1, best);
    if (yieldEvery && i % yieldEvery === 0) await new Promise((r) => setTimeout(r, 0));
  }

  return {
    results: best,
    diagnostics: {
      trials: options.trials,
      passedHard,
      hardFailBy,
      options,
    },
  };
}
