// src/gaia/board/evaluate.ts
import { axialDistance } from "./axial";
import type { NormalizedBoard, NormalizedCell } from "./types";

/**
 * Outer/Touch ペナルティ（テンプレ不変座標：templateKey 直持ち版）
 *
 * templateKey = `${slotId}:${localKey}`
 * - slotId: 盤面スロットID（L1/M3/S2...）
 * - localKey: セクター内ローカル座標キー（sector.cells のキー "dq,dr"）
 *
 * 重要:
 * - OUTER/TODOUCH 定義は templateKey を直接持つ
 * - legacy の "q,r"(coordKey) を使った運用はやめる（移行用ダンプ関数のみ残す）
 */

/* ---------------------------------------------
 * Planet type normalization (既存踏襲)
 * --------------------------------------------- */

export const BASIC_PLANET_TYPES = [
  "BLACK",
  "BLUE",
  "BROWN",
  "ORANGE",
  "RED",
  "WHITE",
  "YELLOW",
] as const;

export type BasicPlanetType = (typeof BASIC_PLANET_TYPES)[number];

const LEGACY_TO_BASIC: Record<string, BasicPlanetType> = {
  TITANIUM: "ORANGE",
  TERRA: "BLUE",
  OXIDE: "BROWN",
  VOLCANIC: "RED",
  ICE: "WHITE",
  DESERT: "YELLOW",
  // 旧表記ゆれ吸収（必要なら追加）
  ORANGE: "ORANGE",
  BLUE: "BLUE",
  BROWN: "BROWN",
  RED: "RED",
  WHITE: "WHITE",
  YELLOW: "YELLOW",
  BLACK: "BLACK",
};

function toBasicPlanetType(pt: string | undefined): BasicPlanetType | null {
  if (!pt) return null;
  const u = String(pt).trim().toUpperCase();
  const b = LEGACY_TO_BASIC[u];
  return b ?? null;
}

function isPlanetCell(c: NormalizedCell): boolean {
  // kind/planetType どちらでも判定できるように（世代混在耐性）
  if ((c as any).kind === "planet") return true;
  if (c.planetType) return true;
  return false;
}

/* ---------------------------------------------
 * TemplateKey helpers
 * --------------------------------------------- */

function getTemplateKey(c: NormalizedCell): string | null {
  const slotId = (c as any).slotId as string | undefined;
  const localKey = (c as any).localKey as string | undefined;
  if (!slotId || !localKey) return null;
  return `${slotId}:${localKey}`;
}

/* ---------------------------------------------
 * Outer/Touch definition (templateKey direct)
 * --------------------------------------------- */

