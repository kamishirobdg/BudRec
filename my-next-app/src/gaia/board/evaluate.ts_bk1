function getKeySetByTemplate(
  templateId: string,
  dict: Record<string, readonly string[]>
): Set<string> {
  const arr = dict[templateId] ?? [];
  return new Set(arr);
}

/* ---------------------------------------------
 * Migration helper (legacy coordKey -> templateKey)
 * --------------------------------------------- */

/**
 * 旧: OUTER/TOUCH を coordKey("q,r") で持っている場合、
 * seed0 参照盤（refBoard）の cellByCoord から templateKey に変換し、
 * コピペ可能な配列文字列を console に出します。
 *
 * 使い方（例）:
 *   const ref = buildNormalizedBoard({ template, placements: SEED0, ... });
 *   dumpLegacyOuterTouchAsTemplateKeys(ref, "3p_lostFleet", legacyOuterCoords, legacyTouchCoords);
 *
 * ※ この関数自体は evaluate のロジックには使いません。
 */
export function dumpLegacyOuterTouchAsTemplateKeys(
  refBoard: NormalizedBoard,
  templateId: string,
  legacyOuterCoordKeys: readonly string[],
  legacyTouchCoordKeys: readonly string[]
): void {
  const convert = (coords: readonly string[]) => {
    const out: string[] = [];
    const missing: string[] = [];
    for (const ck of coords) {
      const c = refBoard.cellByCoord.get(ck);
      if (!c) {
        missing.push(ck);
        continue;
      }
      const tk = getTemplateKey(c);
      if (!tk) {
        missing.push(ck);
        continue;
      }
      out.push(tk);
    }
    out.sort();
    return { out, missing };
  };

  const a = convert(legacyOuterCoordKeys);
  const b = convert(legacyTouchCoordKeys);

  // コピペしやすい形で出す
  console.log(`[dump] templateId=${templateId}`);
  console.log(`OUTER_KEYS_BY_TEMPLATE["${templateId}"] = [`);
  for (const x of a.out) console.log(`  "${x}",`);
  console.log(`];`);
  if (a.missing.length) console.warn("[dump] OUTER missing coordKeys:", a.missing);

  console.log(`TOUCH_KEYS_BY_TEMPLATE["${templateId}"] = [`);
  for (const x of b.out) console.log(`  "${x}",`);
  console.log(`];`);
  if (b.missing.length) console.warn("[dump] TOUCH missing coordKeys:", b.missing);
}

/* ---------------------------------------------
 * Evaluate
 * --------------------------------------------- */

export type EvalResult = {
  planetCellCount: number;
  edgesPlanetPlanet: number;
  edgesSameType: number;
  edgesDifferentType: number;

  templateId: string;

  outerPlanetCountAll: number;
  touchPlanetCountAll: number;

  penaltyOuter: number;
  penaltyTouch: number;
  penaltyOuterTouchTotal: number;

  outerKeysTotal: number;
  outerKeysHit: number;
  outerKeysMissingSample: string[];

  touchKeysTotal: number;
  touchKeysHit: number;
};

export function evaluateBoard(board: NormalizedBoard): EvalResult {
  const templateId = board.templateId;

  // --- 基本の惑星/辺評価（既存踏襲の簡易版） ---
  const planetCells = board.cells.filter(isPlanetCell);
  const planetCellCount = planetCells.length;

  // planet-planet edges を数える（重複防止）
  const seenEdge = new Set<string>();
  let edgesPlanetPlanet = 0;
  let edgesSameType = 0;
  let edgesDifferentType = 0;

  for (const c of planetCells) {
    for (const nbKey of c.neighbors ?? []) {
      const nb = board.cellByCoord.get(nbKey);
      if (!nb || !isPlanetCell(nb)) continue;

      const a = c.coordKey;
      const b = nb.coordKey;
      const ekey = a < b ? `${a}|${b}` : `${b}|${a}`;
      if (seenEdge.has(ekey)) continue;
      seenEdge.add(ekey);

      edgesPlanetPlanet++;

      const t1 = toBasicPlanetType(c.planetType);
      const t2 = toBasicPlanetType(nb.planetType);
      if (t1 && t2 && t1 === t2) edgesSameType++;
      else edgesDifferentType++;
    }
  }

  // --- Outer/Touch (templateKey set membership) ---
  const outerSet = getKeySetByTemplate(templateId, OUTER_KEYS_BY_TEMPLATE);
  const touchSet = getKeySetByTemplate(templateId, TOUCH_KEYS_BY_TEMPLATE);

  const outerKeysTotal = outerSet.size;
  const touchKeysTotal = touchSet.size;

  let outerKeysHit = 0;
  let touchKeysHit = 0;

  let outerPlanetCountAll = 0;
  let touchPlanetCountAll = 0;

  const outerMissing: string[] = [];

  // board 側の templateKey で判定する
  for (const c of planetCells) {
    const tk = getTemplateKey(c);
    if (!tk) continue;

    if (outerSet.has(tk)) {
      outerPlanetCountAll++;
      outerKeysHit++;
    }
    if (touchSet.has(tk)) {
      touchPlanetCountAll++;
      touchKeysHit++;
    }
  }

  // outerSet 側から見た “盤面に該当keyが存在するか” のサンプルも出す（デバッグ用途）
  if (outerSet.size > 0) {
    for (const k of outerSet) {
      // 盤面セルに該当 templateKey が存在するか
      const exists = board.cells.some((c) => getTemplateKey(c) === k);
      if (!exists) {
        outerMissing.push(k);
        if (outerMissing.length >= 20) break;
      }
    }
  }

  // ペナルティ設計（SOFT）
  // ※ 係数は現行設計に合わせて調整してください。ここでは「存在数に比例」で置きます。
  const penaltyOuter = outerPlanetCountAll;
  const penaltyTouch = touchPlanetCountAll;
  const penaltyOuterTouchTotal = penaltyOuter + penaltyTouch;

  return {
    planetCellCount,
    edgesPlanetPlanet,
    edgesSameType,
    edgesDifferentType,

    templateId,

    outerPlanetCountAll,
    touchPlanetCountAll,

    penaltyOuter,
    penaltyTouch,
    penaltyOuterTouchTotal,

    outerKeysTotal,
    outerKeysHit,
    outerKeysMissingSample: outerMissing,

    touchKeysTotal,
    touchKeysHit,
  };
}
