// src/gaia/board/previewBoard.ts
//
// UI preview helper: expand (slotId, sectorId, rot) placements into absolute board cells.
// Keep this module stable & side‑effect free.

export type Axial = { q: number; r: number };

export type SlotAccept = "LARGE" | "MIDDLE" | "SMALL";
export type Slot = { slotId: string; pos: Axial; accepts: SlotAccept[] };

type AnySector = any;

export type PlacementItem = {
  slotId: string;
  sectorId: string;
  rot: number; // 0..5 (60° steps)
};

export type BoardCell = {
  pos: Axial; // board absolute axial
  kind: "planet" | "space" | "special";
  planetType?: string;
  tags: string[];
  slotId: string;
  sectorId: string;
  /** Raw tile-local key from sector.cells (pre-rotation). */
  localKey?: string;
};

function parseKey(key: string): Axial {
  const [q, r] = key.split(",").map((v) => Number(v));
  return { q, r };
}

function keyOf(p: Axial) {
  return `${p.q},${p.r}`;
}

export function axialAdd(a: Axial, b: Axial): Axial {
  return { q: a.q + b.q, r: a.r + b.r };
}

/**
 * Tile-local coordinate normalization.
 * Your base sectors (01..10 etc.) are authored in an offset-like row-shifted grid.
 * Normalize to axial BEFORE rotation:
 *   q_axial = q - floor(r/2), r_axial = r
 */
function toAxialLocal(local: Axial): Axial {
  return { q: local.q - Math.floor(local.r / 2), r: local.r };
}

/** Rotate axial(q,r) by 60° steps CW using cube rotation. */
function rotate60CW(ax: Axial, stepsCW: number): Axial {
  let q = ax.q;
  let r = ax.r;
  const s = ((stepsCW % 6) + 6) % 6;

  for (let i = 0; i < s; i++) {
    const x = q;
    const z = r;
    const y = -x - z;

    // cube CW: (x,y,z) -> (-z, -x, -y)
    const nx = -z;
    const ny = -x;
    const nz = -y;

    q = nx;
    r = nz;
  }
  return { q, r };
}

/**
 * Slot position normalization.
 * Templates are authored in a row-shifted coordinate; convert to axial for board composition.
 */
function fixSlotWorldPos(pos: Axial): Axial {
  return pos;
}

export function axialRotate(pos: Axial, rot: number): Axial {
  // Backward-compat helper: rotate CW by 60° steps.
  return rotate60CW(pos, rot);
}

function normalizeCell(raw: any): { kind: "planet" | "space" | "special"; planetType?: string; tags: string[] } {
  const k = raw?.kind;
  const tags = Array.isArray(raw?.tags) ? raw.tags : [];

  if (k === "planet") {
    const pt = (raw?.planetType ?? raw?.planet) as string | undefined;
    return { kind: "planet", planetType: pt, tags };
  }
  if (k === "special") return { kind: "special", tags };
  return { kind: "space", tags };
}

export function buildSectorLookup(sectors: AnySector[]): Map<string, AnySector> {
  const m = new Map<string, AnySector>();
  for (const s of sectors) {
    const id = (s?.sectorId ?? s?.id) as string | undefined;
    if (!id) continue;
    m.set(id, { ...s, sectorId: id });
  }
  return m;
}

export function expandPlacementToBoardCells(args: {
  slots: Slot[];
  placement: PlacementItem[];
  sectorById: Map<string, AnySector>;
}): BoardCell[] {
  const { slots, placement, sectorById } = args;
  const slotById = new Map(slots.map((s) => [s.slotId, s]));

  const out: BoardCell[] = [];

  for (const p of placement) {
    const slot = slotById.get(p.slotId);
    const sector = sectorById.get(p.sectorId);
    if (!slot || !sector) continue;

    const slotPos = fixSlotWorldPos(slot.pos);
    const rot = Number((p as any).rot ?? 0);

    const cells: Record<string, any> = sector.cells ?? {};
    for (const [k, rawCell] of Object.entries(cells)) {
const local0 = parseKey(k);

// base(01-10)だけ補正、それ以外はそのまま
const sid = String((sector as any).sectorId ?? (sector as any).id ?? "");
const isBase = /^(0[1-9]|10)$/.test(sid);

const local = isBase
  ? { q: local0.q - Math.floor(local0.r / 2), r: local0.r }
  : local0;

      const localAx = toAxialLocal(local0);
      const rotated = rotate60CW(localAx, rot);
      const abs = axialAdd(slotPos, rotated);
      const norm = normalizeCell(rawCell);

      out.push({
        pos: abs,
        kind: norm.kind,
        planetType: norm.planetType,
        tags: norm.tags,
        slotId: p.slotId,
        sectorId: p.sectorId,
        localKey: k,
      });
    }
  }

  // Preview: last write wins on duplicate coords.
  const uniq = new Map<string, BoardCell>();
  for (const c of out) uniq.set(keyOf(c.pos), c);
  return [...uniq.values()];
}

/**
 * Template adjustment helper: assign sectorId cyclically by slot type (rot=0).
 */
export function makeCycledPlacement(args: {
  slots: Slot[];
  largeIds: string[];
  middleIds: string[];
  smallIds: string[];
}): PlacementItem[] {
  const { slots, largeIds, middleIds, smallIds } = args;

  let iL = 0;
  let iM = 0;
  let iS = 0;

  return slots.map((s) => {
    const a0 = s.accepts[0];
    let sectorId = "";
    if (a0 === "LARGE") {
      sectorId = largeIds[iL % Math.max(1, largeIds.length)] ?? "";
      iL++;
    } else if (a0 === "MIDDLE") {
      sectorId = middleIds[iM % Math.max(1, middleIds.length)] ?? "";
      iM++;
    } else {
      sectorId = smallIds[iS % Math.max(1, smallIds.length)] ?? "";
      iS++;
    }
    return { slotId: s.slotId, sectorId, rot: 0 };
  });
}
