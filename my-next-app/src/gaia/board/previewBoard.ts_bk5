// src/gaia/board/previewBoard.ts
//
// UI preview expansion for Gaia Project (Lost Fleet).
// This file MUST stay mathematically consistent with normalize.ts (evaluation).
//
// Key conventions:
// - Sector `cells` keys are treated as tile-local coordinates.
// - Rotation is applied in axial coordinates (60° steps).
// - slot.pos is assumed to be authored in axial coordinates (no implicit conversion).
//
// IMPORTANT: Base sectors 01-10 are known to use a row-shifted encoding in `cells` keys.
// We normalize ONLY those sector ids to axial using:
//   q_axial = q - floor(r/2), r_axial = r
// (This matches the confirmed behavior on sector "02".)

export type Axial = { q: number; r: number };

export type SlotAccept = "LARGE" | "MIDDLE" | "SMALL";
export type Slot = { slotId: string; pos: Axial; accepts: SlotAccept[] };

type AnySector = any;

export type PlacementItem = {
  slotId: string;
  sectorId: string;
  rot: number; // 0..5 (60deg steps)
};

export type BoardCell = {
  pos: Axial; // board absolute (axial)
  kind: "planet" | "space" | "special";
  planetType?: string;
  tags: string[];
  slotId: string;
  sectorId: string;
  /** Raw tile-local key from sector.cells (before rotation/placement). */
  localKey?: string;
};

function parseKey(key: string): Axial {
  const [q, r] = key.split(",").map((v) => Number(v));
  return { q, r };
}

function keyOf(p: Axial) {
  return `${p.q},${p.r}`;
}

export function axialAdd(a: Axial, b: Axial): Axial {
  return { q: a.q + b.q, r: a.r + b.r };
}

function isBaseSectorId(sectorId: string): boolean {
  return /^(0[1-9]|10)$/.test(sectorId);
}

/** Normalize sector-local key into axial coords (ONLY for base 01-10). */
function normalizeLocalForSector(sectorId: string, local: Axial): Axial {
  if (!isBaseSectorId(sectorId)) return local;
  return { q: local.q - Math.floor(local.r / 2), r: local.r };
}

/** Rotate axial(q,r) by 60° steps CW via cube rotation. */
function rotate60(ax: Axial, stepsCW: number): Axial {
  let q = ax.q;
  let r = ax.r;
  const s = ((stepsCW % 6) + 6) % 6;

  for (let i = 0; i < s; i++) {
    const x = q;
    const z = r;
    const y = -x - z;

    // cube CW: (x,y,z) -> (-z, -x, -y)
    const nx = -z;
    const ny = -x;
    const nz = -y;

    q = nx;
    r = nz;
  }
  return { q, r };
}

/**
 * Legacy helper kept for compatibility with older callers.
 * NOTE: slot.pos is treated as axial as-authored (identity).
 */
function fixSlotWorldPos(pos: Axial): Axial {
  return pos;
}

export function axialRotate(pos: Axial, rot: number): Axial {
  return rotate60(pos, rot);
}

export function buildSectorLookup(sectors: AnySector[]): Map<string, AnySector> {
  const m = new Map<string, AnySector>();
  for (const s of sectors) {
    const id = (s?.sectorId ?? s?.id) as string | undefined;
    if (!id) continue;
    m.set(id, { ...s, sectorId: id });
  }
  return m;
}

function normalizeCell(raw: any): { kind: "planet" | "space" | "special"; planetType?: string; tags: string[] } {
  const k = raw?.kind;
  const tags = Array.isArray(raw?.tags) ? raw.tags : [];

  if (k === "planet") {
    const pt = (raw?.planetType ?? raw?.planet) as string | undefined;
    return { kind: "planet", planetType: pt, tags };
  }
  if (k === "special") return { kind: "special", tags };
  return { kind: "space", tags };
}

export function expandPlacementToBoardCells(args: {
  slots: Slot[];
  placement: PlacementItem[];
  sectorById: Map<string, AnySector>;
}): BoardCell[] {
  const { slots, placement, sectorById } = args;
  const slotById = new Map(slots.map((s) => [s.slotId, s]));
  const out: BoardCell[] = [];

  for (const p of placement) {
    const slot = slotById.get(p.slotId);
    const sector = sectorById.get(p.sectorId);
    if (!slot || !sector) continue;

    const slotPos = fixSlotWorldPos(slot.pos);

    const sectorId = String((sector as any).sectorId ?? (sector as any).id ?? p.sectorId);
    const rot = Number((p as any).rot ?? 0);

    const cellsRec: Record<string, any> = (sector as any).cells ?? {};
    for (const [k, rawCell] of Object.entries(cellsRec)) {
      const localKey = String(k).trim();
      const local0 = parseKey(localKey);

      // Normalize local (base only) BEFORE rotation
      const local = normalizeLocalForSector(sectorId, local0);

      const rotated = rotate60(local, rot);
      const abs = axialAdd(slotPos, rotated);

      const norm = normalizeCell(rawCell);
      out.push({
        pos: abs,
        kind: norm.kind,
        planetType: norm.planetType,
        tags: norm.tags,
        slotId: p.slotId,
        sectorId,
        localKey,
      });
    }
  }

  // Preview: last-write-wins for collisions
  const uniq = new Map<string, BoardCell>();
  for (const c of out) uniq.set(keyOf(c.pos), c);
  return [...uniq.values()];
}

/**
 * Template調整用：slot種別に応じて sectorId を順番に割り当てる（rot=0固定）
 * - LARGE / MIDDLE / SMALL の3プールを用意し、足りなければ循環
 */
export function makeCycledPlacement(args: {
  slots: Slot[];
  largeIds: string[];
  middleIds: string[];
  smallIds: string[];
}): PlacementItem[] {
  const { slots, largeIds, middleIds, smallIds } = args;

  let iL = 0, iM = 0, iS = 0;

  return slots.map((s) => {
    const a0 = s.accepts[0];
    let sectorId = "";
    if (a0 === "LARGE") {
      sectorId = largeIds[iL % Math.max(1, largeIds.length)] ?? "";
      iL++;
    } else if (a0 === "MIDDLE") {
      sectorId = middleIds[iM % Math.max(1, middleIds.length)] ?? "";
      iM++;
    } else {
      sectorId = smallIds[iS % Math.max(1, smallIds.length)] ?? "";
      iS++;
    }
    return { slotId: s.slotId, sectorId, rot: 0 };
  });
}
