import type { Axial } from "./types";
import { Board } from "./board";
import { add } from "./hex";

export type ConstraintContext = {
  forbiddenProximityTags: ReadonlySet<string>;
  forbiddenRadius: number; // 2固定（あなた要件）
};

function hasTag(tileTags: readonly string[] | undefined, tag: string): boolean {
  return !!tileTags && tileTags.includes(tag);
}

// cube距離 <= radius のoffsetを作る（0,0除外）
function offsetsWithinRadius(radius: number): Axial[] {
  const out: Axial[] = [];
  for (let q = -radius; q <= radius; q++) {
    for (let r = -radius; r <= radius; r++) {
      const s = -q - r;
      const dist = (Math.abs(q) + Math.abs(r) + Math.abs(s)) / 2;
      if (dist <= radius && !(q === 0 && r === 0)) out.push({ q, r });
    }
  }
  return out;
}

const offsetCache = new Map<number, Axial[]>();
function getOffsets(radius: number): Axial[] {
  const hit = offsetCache.get(radius);
  if (hit) return hit;
  const v = offsetsWithinRadius(radius);
  offsetCache.set(radius, v);
  return v;
}

/**
 * Board上のposに置いたタイルが、距離<=radius範囲内に同タグを見つけたらNG。
 * - ベースゲームでも採用（あなた要件）
 */
export function violatesForbiddenProximity(board: Board, pos: Axial, ctx: ConstraintContext): boolean {
  const me = board.get(pos);
  if (!me) return false;

  const myTags = me.tile.tags ?? [];
  const myTargets = Array.from(ctx.forbiddenProximityTags).filter((t) => hasTag(myTags, t));
  if (myTargets.length === 0) return false;

  const offsets = getOffsets(Math.max(1, Math.floor(ctx.forbiddenRadius)));

  for (const off of offsets) {
    const p = add(pos, off);
    const other = board.get(p);
    if (!other) continue;

    const otherTags = other.tile.tags ?? [];
    for (const tag of myTargets) {
      if (hasTag(otherTags, tag)) return true;
    }
  }
  return false;
}
