};

type NormalizedBoardLike = {
  templateId: string;
  cells: NormalizedCellLike[];
  cellByCoord: Map<string, NormalizedCellLike>;
};

function keyOf(q: number, r: number) {
  return `${q},${r}`;
}

function renderAsciiFromBoardCells(cells: BoardCell[], mode: "planet" | "slot" | "sector") {
