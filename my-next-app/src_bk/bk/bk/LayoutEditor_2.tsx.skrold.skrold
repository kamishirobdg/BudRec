// src/components/LayoutEditor.tsx
"use client";

import React, { useCallback, useMemo, useState } from "react";

import type { Axial } from "@/TRANSDIM/types";
import type { MapLayoutTemplate } from "@/TRANSDIM/mapTemplates";
import { loadTemplates, upsertTemplate } from "@/TRANSDIM/templateStore";
import { axialToPixel, hexPoints } from "@/TRANSDIM/hexLayout";

type TemplateId = string;

type Cube = { x: number; y: number; z: number };

function axialToCube(a: Axial): Cube {
  const x = a.q;
  const z = a.r;
  const y = -x - z;
  return { x, y, z };
}

function cubeToAxial(c: Cube): Axial {
  return { q: c.x, r: c.z };
}

// Standard cube rounding for axial coords.
function cubeRound(c: { x: number; y: number; z: number }): Cube {
  let rx = Math.round(c.x);
  let ry = Math.round(c.y);
  let rz = Math.round(c.z);

  const xDiff = Math.abs(rx - c.x);
  const yDiff = Math.abs(ry - c.y);
  const zDiff = Math.abs(rz - c.z);

  if (xDiff > yDiff && xDiff > zDiff) rx = -ry - rz;
  else if (yDiff > zDiff) ry = -rx - rz;
  else rz = -rx - ry;

  return { x: rx, y: ry, z: rz };
}

/**
 * Pixel -> Axial (pointy-top axial layout)
 * Assumption: hexLayout.axialToPixel uses the canonical pointy-top mapping:
 *   x = size * (sqrt(3) * q + sqrt(3)/2 * r)
 *   y = size * (3/2 * r)
 *
 * If your hexLayout differs, this editor still works reasonably well because it snaps via cube rounding.
 */
function pixelToAxialPointy(px: { x: number; y: number }, size: number): Axial {
  const sqrt3 = Math.sqrt(3);
  const q = (sqrt3 / 3 * px.x - 1 / 3 * px.y) / size;
  const r = (2 / 3 * px.y) / size;
  const cube = cubeRound({ x: q, y: -q - r, z: r });
  return cubeToAxial(cube);
}

function keyOf(a: Axial): string {
  return `${a.q},${a.r}`;
}

function uniqAxials(axials: Axial[]): Axial[] {
  const seen = new Set<string>();
  const out: Axial[] = [];
  for (const a of axials) {
    const k = keyOf(a);
    if (seen.has(k)) continue;
    seen.add(k);
    out.push(a);
  }
  return out;
}

export default function LayoutEditor() {
  const [templates, setTemplates] = useState<MapLayoutTemplate[]>(() => loadTemplates());
  const [templateId, setTemplateId] = useState<TemplateId>(() => templates[0]?.id ?? "");
  const [selectedSlotIndex, setSelectedSlotIndex] = useState<number | "">( "");

  const activeTemplate = useMemo(() => templates.find((t) => t.id === templateId) ?? null, [templates, templateId]);

  // Viewport config (simple, stable, no dependence on MapViewer heavy logic)
  const size = 38; // hex radius-ish used for axialToPixel & picking
  const origin = { x: 520, y: 360 }; // SVG center offset

  const gridRadius = 10;

  const gridCells = useMemo(() => {
    const cells: Axial[] = [];
    for (let q = -gridRadius; q <= gridRadius; q++) {
      for (let r = -gridRadius; r <= gridRadius; r++) {
        // keep a rough hex-shaped region
        const s = -q - r;
        if (Math.max(Math.abs(q), Math.abs(r), Math.abs(s)) <= gridRadius) {
          cells.push({ q, r });
        }
      }
    }
    return cells;
  }, [gridRadius]);

  const slotAnchors = useMemo(() => {
    if (!activeTemplate) return [];
    return activeTemplate.slots.map((s, i) => ({ i, kind: s.kind, pos: s.pos }));
  }, [activeTemplate]);

  const persistTemplate = useCallback(
    (next: MapLayoutTemplate) => {
      upsertTemplate(next);
      // reload to keep store normalization consistent across the app
      const reloaded = loadTemplates();
      setTemplates(reloaded);
      setTemplateId(next.id);
    },
    []
  );

  const onPickTemplate = useCallback(
    (id: string) => {
      setTemplateId(id);
      setSelectedSlotIndex("");
    },
    []
  );

  const onSvgClick = useCallback(
    (e: React.MouseEvent<SVGSVGElement>) => {
      if (!activeTemplate) return;
      if (selectedSlotIndex === "") return;

      const rect = e.currentTarget.getBoundingClientRect();
      const x = e.clientX - rect.left - origin.x;
      const y = e.clientY - rect.top - origin.y;

      const a = pixelToAxialPointy({ x, y }, size);

      const next: MapLayoutTemplate = {
        ...activeTemplate,
        slots: activeTemplate.slots.map((s, i) => (i === selectedSlotIndex ? { ...s, pos: a } : s)),
      };

      persistTemplate(next);
    },
    [activeTemplate, selectedSlotIndex, origin.x, origin.y, size, persistTemplate]
  );

  const onNudge = useCallback(
    (dq: number, dr: number) => {
      if (!activeTemplate) return;
      if (selectedSlotIndex === "") return;

      const cur = activeTemplate.slots[selectedSlotIndex]?.pos ?? { q: 0, r: 0 };
      const nextPos = { q: cur.q + dq, r: cur.r + dr };

      const next: MapLayoutTemplate = {
        ...activeTemplate,
        slots: activeTemplate.slots.map((s, i) => (i === selectedSlotIndex ? { ...s, pos: nextPos } : s)),
      };

      persistTemplate(next);
    },
    [activeTemplate, selectedSlotIndex, persistTemplate]
  );

  // Compute a viewBox that always shows the whole grid region.
  const vb = useMemo(() => {
    const pts = gridCells.map((a) => {
      const p = axialToPixel(a, size, "pointy");
      return { x: p.x + origin.x, y: p.y + origin.y };
    });
    // also include slot anchors so large coords are still visible
    for (const s of slotAnchors) {
      const p = axialToPixel(s.pos, size, "pointy");
      pts.push({ x: p.x + origin.x, y: p.y + origin.y });
    }

    const xs = pts.map((p) => p.x);
    const ys = pts.map((p) => p.y);

    const minX = Math.min(...xs) - size * 2.2;
    const maxX = Math.max(...xs) + size * 2.2;
    const minY = Math.min(...ys) - size * 2.2;
    const maxY = Math.max(...ys) + size * 2.2;

    const w = Math.max(900, maxX - minX);
    const h = Math.max(650, maxY - minY);
    return { x: minX, y: minY, w, h };
  }, [gridCells, slotAnchors, origin.x, origin.y, size]);

  return (
    <div style={{ display: "flex", gap: 16, alignItems: "flex-start" }}>
      <div style={{ width: 360 }}>
        <h2 style={{ margin: "8px 0 12px" }}>Layout Editor</h2>

        <div style={{ marginBottom: 10 }}>
          <div style={{ fontSize: 12, opacity: 0.8, marginBottom: 6 }}>Template</div>
          <select
            value={templateId}
            onChange={(e) => onPickTemplate(e.target.value)}
            style={{ width: "100%", padding: 6 }}
          >
            {templates.map((t) => (
              <option key={t.id} value={t.id}>
                {t.label} [{t.id}]
              </option>
            ))}
          </select>
        </div>

        <div style={{ marginBottom: 10 }}>
          <div style={{ fontSize: 12, opacity: 0.8, marginBottom: 6 }}>Slot</div>
          <select
            value={selectedSlotIndex}
            onChange={(e) => {
              const v = e.target.value;
              setSelectedSlotIndex(v === "" ? "" : Number(v));
            }}
            style={{ width: "100%", padding: 6 }}
          >
            <option value="">(select slotIndex)</option>
            {activeTemplate?.slots.map((s, i) => (
              <option key={i} value={i}>
                [{i}] {s.kind} (q={s.pos.q}, r={s.pos.r})
              </option>
            ))}
          </select>
          <div style={{ fontSize: 12, opacity: 0.75, marginTop: 6 }}>
            手順: slotIndex を選択 → 盤面セルをクリック（pos更新）
          </div>
        </div>

        <div style={{ display: "grid", gridTemplateColumns: "repeat(3, 1fr)", gap: 6, marginBottom: 10 }}>
          <button onClick={() => onNudge(0, -1)} disabled={selectedSlotIndex === ""}>↑</button>
          <button onClick={() => onNudge(-1, 0)} disabled={selectedSlotIndex === ""}>q-</button>
          <button onClick={() => onNudge(1, 0)} disabled={selectedSlotIndex === ""}>q+</button>
          <button onClick={() => onNudge(0, 1)} disabled={selectedSlotIndex === ""}>↓</button>
          <button onClick={() => onNudge(0, 0)} disabled style={{ opacity: 0.6 }}> </button>
          <button onClick={() => onNudge(0, 0)} disabled style={{ opacity: 0.6 }}> </button>
        </div>

        <div style={{ fontSize: 12, opacity: 0.75 }}>
          備考: このページは「配置確定」専用です。スコア・探索・履歴は扱いません。
        </div>
      </div>

      <div style={{ flex: 1, minWidth: 720 }}>
        <div style={{ border: "1px solid #ddd", borderRadius: 10, overflow: "auto", height: "82vh" }}>
          <svg
            viewBox={`${vb.x} ${vb.y} ${vb.w} ${vb.h}`}
            width={vb.w}
            height={vb.h}
            onClick={onSvgClick}
            style={{ display: "block", background: "#fafafa" }}
          >
            {/* grid */}
            {gridCells.map((a) => {
              const p = axialToPixel(a, size, "pointy");
              const cx = p.x + origin.x;
              const cy = p.y + origin.y;

              const pts = hexPoints({ x: cx, y: cy }, size);
              return (
                <polygon
                  key={keyOf(a)}
                  points={Array.isArray(pts) ? pts.map((pt: any) => `${pt.x},${pt.y}`).join(" ") : (pts as any)}
                  fill="white"
                  stroke="#e0e0e0"
                  strokeWidth={1}
                />
              );
            })}

            {/* slot anchors */}
            {slotAnchors.map((s) => {
              const p = axialToPixel(s.pos, size, "pointy");
              const cx = p.x + origin.x;
              const cy = p.y + origin.y;

              const isSelected = selectedSlotIndex !== "" && s.i === selectedSlotIndex;

              return (
                <g key={`slot-${s.i}`} pointerEvents="none">
                  <circle cx={cx} cy={cy} r={size * 0.33} fill={isSelected ? "#ffd54f" : "#616161"} opacity={0.85} />
                  <text x={cx} y={cy + 4} textAnchor="middle" fontSize={12} fill="black">
                    {s.i}
                  </text>
                </g>
              );
            })}
          </svg>
        </div>
      </div>
    </div>
  );
}
